# ITIAP Frontend — LOCAL overrides. NOT tracked by git.
# Copy this file:  cp .env.example .env
# then edit .env with YOUR OWN values. Never commit .env.
#
# Spring Boot loads .env automatically (see spring.config.import in
# src/main/resources/application.properties), and .env entries win over the
# defaults there. Environment variables win over .env if both are set.

# ── Backend base URL this UI talks to ──
BACKEND_URL=http://127.0.0.1:5050

# ── Shared Frontend -> Backend server credential ──
# Must exactly match Backend/.env. Generate at least 32 random characters.
# Keep this server-side; never expose it to browser JavaScript.
INTERNAL_API_SECRET=SET_TO_THE_RANDOM_SECRET_FROM_BACKEND_ENV

# Local HTTP only; set true when the Frontend is served over HTTPS.
SESSION_COOKIE_SECURE=false
DEV_LOGIN_ENABLED=false
