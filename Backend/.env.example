# ITIAP Backend — LOCAL overrides. NOT tracked by git.
# Copy this file:  cp .env.example .env
# then edit .env with YOUR OWN values. Never commit .env.
#
# Spring Boot loads .env automatically (see spring.config.import in
# src/main/resources/application.properties), and .env entries win over the
# defaults there. Environment variables win over .env if both are set.

# ── Database (your own local Postgres) ──
DB_URL=jdbc:postgresql://localhost:5432/itiaplocal
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ── CORS (comma-separated exact origins only; never use *) ──
CORS_ALLOWED_ORIGINS=http://localhost:5051,http://127.0.0.1:5051

# Bind only to loopback for same-host local development.
BACKEND_BIND_ADDRESS=127.0.0.1
SESSION_COOKIE_SECURE=false

# ── Shared Frontend -> Backend server credential ──
# Generate a random value of at least 32 characters and use the SAME value
# in Frontend/.env. Do not commit the real value.
INTERNAL_API_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# ── Official-user JWT signing key ──
# Generate with: openssl rand -base64 32
# Configure the same value only in Backend/.env (the Frontend never receives it).
APP_JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_32_BYTE_KEY
